---
/**
 * すべてのページの外枠（<html> / <head> / <body>）
 *
 * ページ遷移の演出は View Transitions（ClientRouter）で行う。
 * ClientRouter を使うと、ページ内の <script> は遷移のたびに再実行されないため、
 * 初期化は astro:page-load で行う（.claude/rules/astro-components.md）。
 */
import '@/styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { SITE_NAME } from '@/lib/site';
import { toJsonLd } from '@/lib/structured-data';
import SectionTransition from './SectionTransition.astro';

interface Props {
  /** <title> にそのまま使う（Home 以外は pageTitle() で組み立てる） */
  title: string;
  description?: string;
  /** 検索エンジン向けの構造化データ（lib/structured-data.ts で組み立てる）。Home でのみ渡す */
  structuredData?: object;
}

const { title, description, structuredData } = Astro.props;
// 共有・検索で同じページが別の URL として扱われないよう、正規の URL を示す。
// ビルド時の Astro.url は出力ファイル名（/notes/foo.html、/index.html）になるため、公開される URL の形に直す
const canonical = new URL(
  Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'),
  Astro.site,
);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      JavaScript が動くことを CSS に伝える（global.css の js: バリアント）。
      描画前に付けるため is:inline で <head> に直接書く。
      ClientRouter は遷移のたびに <html> の属性を新しいページのものに置き換えるため、遷移後にも付け直す
    -->
    <script is:inline>
      document.documentElement.dataset.js = '';
      if (!window.__jsFlagListener) {
        window.__jsFlagListener = true;
        document.addEventListener('astro:after-swap', () => {
          document.documentElement.dataset.js = '';
        });
      }
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <!--
      SNS・Slack で共有したときの表示（OGP）。画像は全ページ共通の public/og.png（1200×630）。
      og:image は絶対 URL でないと読まれないサービスがあるため、site を基準に組み立てる。
      SVG は多くのサービスで表示されないため PNG にしている
    -->
    <!-- 記事の本文は Zenn で公開し、このサイトに記事のページはないため、すべて website -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- 代替テキストは画像に書かれている文字（名前と WEB ENGINEER）に合わせる。職種を変えたら og.png と一緒に直す -->
    <meta property="og:image:alt" content={`${SITE_NAME} – Web Engineer`} />
    <meta name="twitter:card" content="summary_large_image" />
    {structuredData && <script type="application/ld+json" set:html={toJsonLd(structuredData)} />}
    <Font cssVariable="--font-montserrat" preload />
    <ClientRouter />
  </head>
  <body class="min-h-dvh bg-bg font-sans text-white/80 antialiased selection:bg-white/20">
    <slot />
    <SectionTransition />
  </body>
</html>

---
/**
 * すべてのページの外枠（<html> / <head> / <body>）
 *
 * ページ遷移の演出は View Transitions（ClientRouter）で行う。
 * ClientRouter を使うと、ページ内の <script> は遷移のたびに再実行されないため、
 * 初期化は astro:page-load で行う（.claude/rules/astro-components.md）。
 */
import '@/styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

interface Props {
  /** <title> にそのまま使う（pageTitle() で組み立てる） */
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      JavaScript が動くことを CSS に伝える（global.css の js: バリアント）。
      描画前に付けるため is:inline で <head> に直接書く。
      ClientRouter は遷移のたびに <html> の属性を新しいページのものに置き換えるため、遷移後にも付け直す
    -->
    <script is:inline>
      document.documentElement.dataset.js = '';
      if (!window.__jsFlagListener) {
        window.__jsFlagListener = true;
        document.addEventListener('astro:after-swap', () => {
          document.documentElement.dataset.js = '';
        });
      }
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <Font cssVariable="--font-montserrat" preload />
    <ClientRouter />
  </head>
  <body class="min-h-dvh bg-bg font-sans text-white/80 antialiased selection:bg-white/20">
    <slot />
  </body>
</html>

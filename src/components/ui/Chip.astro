---
/**
 * 丸い枠のタグ（Tech タグなど）。すべてリンクとして使う
 */
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a
  href={href}
  class="rounded-full border border-white/10 px-2.5 py-1 text-[11px] tracking-wide text-white/60 transition-colors hover:border-white/40 hover:text-white"
>
  {label}
</a>

---
/**
 * 日付ごとにまとめた Activity の列（About の Latest Activity・Activity 一覧）
 *
 * 各行：種類のアイコン・作品名（作品詳細へのリンク）・要約・Tech タグ（screens.md §5.9）。
 * 「もっと見る」で畳む行や、作品での絞り込みの目印は、呼び出し側が data 属性で指定する
 */
import type { ActivityItem } from '@/lib/load-activity';
import Icon from './Icon.astro';
import TechTags from './TechTags.astro';

interface Props {
  groups: { date: string; items: ActivityItem[] }[];
  /** 日付のまとまりに付ける属性（「もっと見る」で畳む data-extra など） */
  groupAttrs?: (group: { date: string; items: ActivityItem[] }) => Record<string, string>;
}

const { groups, groupAttrs } = Astro.props;
---

<div class="space-y-10" data-activity-timeline>
  {groups.map((group) => (
    <div
      class="grid gap-3 sm:grid-cols-[7rem_1fr] sm:gap-6"
      data-activity-date
      {...groupAttrs?.(group)}
    >
      <time datetime={group.date} class="pt-1 text-xs text-white/40">
        {group.date}
      </time>
      <ul class="space-y-6">
        {group.items.map((item) => (
          <li class="flex gap-4" data-activity-item data-work={item.work.id}>
            <Icon name={item.icon} class="pt-0.5 text-lg text-white/40" />
            <div class="min-w-0">
              <a
                href={item.work.href}
                class="text-sm tracking-wide text-white underline-offset-4 hover:underline"
              >
                {item.work.title}
              </a>
              <p class="mt-1 text-sm leading-relaxed text-white/60">{item.summary}</p>
              <TechTags list={item.tags} class="mt-3" />
            </div>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

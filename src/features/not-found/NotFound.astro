---
/**
 * 404 の本文（存在しない URL）
 *
 * どのセクションにも属さないため SectionLayout を使わず、Home と各セクションへの入口だけを置く。
 * 最初に案内したい Home の入口を目立たせる
 */
import PillLink from '@/components/ui/PillLink.astro';
import { SECTION_IDS, SECTIONS } from '@/lib/sections';
---

<main class="mx-auto flex min-h-dvh max-w-3xl flex-col justify-center px-6 py-16 sm:px-10">
  <p class="text-[11px] tracking-[0.3em] text-white/55 uppercase">404</p>
  <h1 class="mt-3 text-2xl font-light tracking-[0.18em] text-white uppercase sm:text-4xl">
    Not Found
  </h1>
  <p class="mt-4 text-sm leading-relaxed text-white/60">
    お探しのページは見つかりませんでした。URL が変わったか、削除された可能性があります。
  </p>
  <nav aria-label="セクション" class="mt-10 flex flex-wrap gap-2">
    <PillLink href="/" emphasis>
      Home
    </PillLink>
    {SECTION_IDS.map((id) => (
      <PillLink href={SECTIONS[id].href}>{SECTIONS[id].title}</PillLink>
    ))}
  </nav>
</main>

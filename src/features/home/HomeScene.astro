---
/**
 * Home の入口（.users/requirements/screens.md §4.1）
 *
 * 中央の名前（About へ）と、その周りの4つの惑星（Career / Works / Tech / Notes）、
 * 左下の職種と GitHub、右下の最新 Activity。
 *
 * ここは HTML と CSS だけで成り立つ入口で、JavaScript が無効でもすべてのセクションへ移動できる。
 * 惑星は四隅に並べて置き、宇宙のシーン（Canvas。scene/）が動き始めたら、その位置と見た目をシーンが引き継ぐ
 * （ルートに data-scene が付くと、group-data-scene/home の指定に切り替わる）。
 */
import Icon from '@/components/ui/Icon.astro';
import { freshnessOf, daysSince } from '@/lib/freshness';
import type { HomePage, PlanetId } from './load-home';

interface Props {
  page: HomePage;
}

const { page } = Astro.props;

/**
 * JavaScript が動くまでの惑星の位置（screens.md §4.1 の図）。
 * 惑星の中心がこの位置に来るよう、-translate-1/2 でずらす
 */
const STATIC_POSITION: Record<PlanetId, string> = {
  career: 'left-[24%] top-[26%] sm:left-[27%]',
  tech: 'left-[76%] top-[26%] sm:left-[73%]',
  works: 'left-[24%] top-[70%] sm:left-[27%]',
  notes: 'left-[76%] top-[70%] sm:left-[73%]',
};

// JavaScript が無効なときの表示。有効なときは閲覧した日で判定し直す（下の <script>）
const buildDate = new Date();
const initialFreshness = page.latest && freshnessOf(daysSince(page.latest.date, buildDate));
---

<div class="group/home fixed inset-0 overflow-hidden" data-home>
  <!--
    イントロを再生するかを、最初の描画より前に決める（名前が一瞬見えてから暗転しないように）。
    同じタブでは1回だけ（サイト内の移動で Home に戻ったときは再生しない）。2回目以降の訪問は短縮版にする。
    prefers-reduced-motion のときは再生しない
  -->
  <script is:inline>
    (() => {
      const root = document.currentScript.parentElement;
      // 背景の動きを止めている（停止ボタン）ときも再生しない
      let motionPaused = false;
      try {
        motionPaused = localStorage.getItem('home-motion') === 'paused';
      } catch {
        // 読めないときは止めていないものとして扱う
      }
      if (
        window.__homeIntroPlayed ||
        motionPaused ||
        matchMedia('(prefers-reduced-motion: reduce)').matches
      )
        return;
      window.__homeIntroPlayed = true;
      let returning = false;
      try {
        returning = localStorage.getItem('intro-seen') === '1';
        localStorage.setItem('intro-seen', '1');
      } catch {
        // 保存できない環境では、毎回はじめから再生する
      }
      root.dataset.intro = 'dark';
      if (returning) root.dataset.introSpeed = 'quick';
    })();
  </script>
  <!-- 星と銀河 -->
  <canvas
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 size-full"
    data-sky
  ></canvas>

  <main class="absolute inset-0 z-10">
    <nav aria-label="セクション">
      {page.planets.map((planet) => (
        <div
          class:list={[
            'absolute isolate flex size-[clamp(64px,18vw,150px)] -translate-1/2 items-center justify-center will-change-transform',
            // シーンが動き始めたら、位置（transform）と大きさ（width / height）はシーンが決める
            'group-data-scene/home:top-0 group-data-scene/home:left-0 group-data-scene/home:translate-none',
            STATIC_POSITION[planet.id],
          ]}
          style={`--p: ${planet.color}`}
          data-planet={planet.id}
          data-moons={planet.moons}
        >
          <a
            href={planet.href}
            class="peer relative z-1 block size-full rounded-full transition-transform duration-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70 group-data-scene/home:scale-(--ds) group-data-scene/home:opacity-(--depth-opacity) group-data-scene/home:hover:scale-[calc(var(--ds)*1.05)] motion-reduce:transition-none"
          >
            {/* 惑星の本体。輪や光が惑星の外まで広がるため、リンクより大きく描く */}
            <canvas
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 left-1/2 size-[210%] -translate-1/2"
              data-planet-canvas
            />
            {/* シーンが動くまでの惑星の代わり。シーンが Canvas に描いたら消す */}
            <span
              aria-hidden="true"
              class="absolute inset-0 rounded-full border border-(--p)/40 bg-radial from-(--p)/30 via-(--p)/8 to-transparent group-data-scene/home:hidden"
            />
            <span class="sr-only">{planet.title}</span>
          </a>
          {/* ラベルは惑星の真下に下げる（惑星と一緒に動き、左右に跳ばないように） */}
          <span
            aria-hidden="true"
            data-intro-hide
            class="pointer-events-none absolute top-full left-1/2 -translate-x-1/2 pt-4 group-data-scene/home:top-[calc(50%+var(--r)+6px)] group-data-scene/home:opacity-(--depth-opacity) pl-[0.35em] text-[11px] leading-none font-semibold tracking-[0.35em] whitespace-nowrap text-white/88 uppercase text-shadow-bg/90 text-shadow-md transition-colors duration-500 peer-hover:text-white peer-focus-visible:text-white sm:text-xs"
          >
            <span class="absolute top-0 left-1/2 h-2.5 w-px bg-linear-to-b from-transparent to-white/60" />
            {planet.title}
            {planet.updated && (
              <span
                hidden
                data-fresh={planet.updated}
                class="ml-[0.2em] inline-block size-[5px] animate-live rounded-full bg-emerald-400 align-middle motion-reduce:animate-none"
              />
            )}
          </span>
        </div>
      ))}
    </nav>

    <!-- 中央：名前。押すと About へ -->
    <div class="absolute top-1/2 left-1/2 z-20 -translate-1/2">
      <a
        href="/about"
        class="group flex flex-col items-center justify-center rounded-full bg-radial-[closest-side] from-bg/90 via-bg/75 via-60% to-transparent px-8 py-7 transition-transform duration-500 hover:scale-104 focus:outline-none focus-visible:scale-104 focus-visible:ring-2 focus-visible:ring-white/70 motion-reduce:transition-none sm:px-12 sm:py-9"
      >
        <h1
          data-home-title
          class="grid pl-[0.25em] text-center text-lg leading-snug font-light tracking-[0.25em] text-white text-shadow-white/40 text-shadow-lg sm:text-2xl lg:text-3xl lg:tracking-[0.3em]"
        >
          {/*
            イントロでは WELCOME が先に浮かび、ビッグバンで名前に入れ替わる（同じ位置に重ねる）。
            名前はハンドルネームの表記（大文字・小文字）どおりに出すため、大文字にするのは WELCOME だけ
          */}
          <span
            aria-hidden="true"
            class="col-start-1 row-start-1 self-center uppercase"
            data-home-welcome
          >
            Welcome
          </span>
          <span class="col-start-1 row-start-1" data-home-name>
            {page.name}
          </span>
        </h1>
        <span
          data-intro-hide
          class="mt-3 flex items-center gap-2 pl-[0.35em] text-[10px] font-medium tracking-[0.35em] text-white/70 uppercase transition-colors group-hover:text-white group-focus-visible:text-white sm:mt-4 sm:text-[11px]"
        >
          <span class="h-px w-3 bg-current"></span>About Me<span class="h-px w-3 bg-current"></span>
        </span>
      </a>
    </div>
  </main>

  <!--
    右上：背景の動きを止める・再開するボタン（WCAG 2.2.2。accessibility.md）。
    セクションのページの閉じるボタンと同じ位置・形。JavaScript が無効なときはシーンが動かないため表示しない
  -->
  <button
    type="button"
    data-motion-toggle
    data-intro-hide
    aria-label="背景の動きを止める"
    class="fixed top-4 right-4 z-30 hidden size-11 items-center justify-center rounded-full border border-white/15 bg-white/5 text-lg text-white/70 transition-colors hover:border-white/40 hover:text-white focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:outline-none js:flex sm:right-8"
  >
    <Icon name="pause" class="group-data-paused/home:hidden" />
    <Icon name="play" class="hidden group-data-paused/home:block" />
  </button>

  <!-- 左下：職種と GitHub（Activity の出どころ）。スマートフォンでは右下の Activity の上に中央寄せ -->
  <div
    data-intro-hide
    class="fixed right-4 bottom-12 left-4 z-10 flex items-center justify-center text-[11px] tracking-[0.25em] text-white/55 uppercase sm:right-auto sm:bottom-10 sm:left-10 sm:justify-start"
  >
    <span>{page.role}</span>
    {page.github && (
      <>
        <span class="mx-3 text-white/25">·</span>
        <a
          href={page.github}
          target="_blank"
          rel="noopener"
          class="flex items-center gap-1.5 text-white/60 transition-colors hover:text-white"
        >
          <Icon name="github-logo" class="text-sm" />
          GitHub
          <Icon name="arrow-up-right" class="text-[10px]" />
        </a>
      </>
    )}
  </div>

  <!-- 右下：最新の Activity。経過日数で点の色・ラベルを変える（screens.md §4.3） -->
  {page.latest && (
    <a
      href="/activity"
      data-latest={page.latest.date}
      data-freshness={initialFreshness}
      data-intro-hide
      class="group fixed right-4 bottom-5 left-4 z-10 flex items-center justify-center gap-2.5 text-[11px] text-white/60 transition-colors hover:text-white sm:right-10 sm:bottom-10 sm:left-auto sm:justify-end"
    >
      <span class="size-1.5 shrink-0 rounded-full bg-emerald-400 group-data-[freshness=live]:animate-live group-data-[freshness=stale]:bg-white/30 motion-reduce:animate-none" />
      <span class="shrink-0 tracking-[0.25em] text-white/55 uppercase">
        <span class="group-data-[freshness=stale]:hidden">Latest</span>
        <span class="hidden group-data-[freshness=stale]:inline">Last update</span>
      </span>
      <span class="truncate tracking-wide">
        <time datetime={page.latest.date}>{page.latest.label}</time> · {page.latest.text}
      </span>
      <Icon name="arrow-right" class="shrink-0 text-white/55" />
    </a>
  )}
</div>

<style is:global>
  /*
   * イントロ（screens.md §4.5）。ルートの data-intro が dark → charge → bang と進み、終わると消える
   * （進め方は scene/intro.ts）。状態ごとに多くの要素の見え方が変わるため、ユーティリティではなくここにまとめる
   */
  @keyframes welcome-emerge {
    from {
      opacity: 0;
      filter: blur(16px);
      transform: scale(0.94);
    }
  }
  [data-home][data-intro] [data-home-title] {
    animation: welcome-emerge 1.5s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
  }
  [data-home][data-intro-speed='quick'] [data-home-title] {
    animation-duration: 0.5s;
    animation-delay: 0s;
  }
  /* ビッグバンの直前に名前が強く光る */
  [data-home][data-intro='charge'] [data-home-title] {
    text-shadow:
      0 0 30px white,
      0 0 90px rgb(255 255 255 / 0.6);
    transition: text-shadow 0.4s ease-in;
  }

  /* WELCOME と名前のクロスフェード */
  [data-home-welcome],
  [data-home-name] {
    transition:
      opacity 0.8s ease,
      filter 0.8s ease;
  }
  [data-home-welcome],
  [data-home][data-intro='dark'] [data-home-name],
  [data-home][data-intro='charge'] [data-home-name] {
    opacity: 0;
    filter: blur(8px);
  }
  [data-home][data-intro='dark'] [data-home-welcome],
  [data-home][data-intro='charge'] [data-home-welcome] {
    opacity: 1;
    filter: none;
  }

  /* ビッグバンまでは惑星を出さず、イントロの間はラベル・補足・四隅を隠して押せないようにする */
  [data-home][data-intro='dark'] [data-planet],
  [data-home][data-intro='charge'] [data-planet],
  [data-home][data-intro] [data-intro-hide] {
    opacity: 0;
  }
  [data-home][data-intro] main,
  [data-home][data-intro] [data-intro-hide] {
    pointer-events: none;
  }
  [data-intro-hide] {
    transition: opacity 1s ease;
  }
</style>

<script>
  import { daysSince, freshnessOf } from '@/lib/freshness';
  import { createIntro, runIntro } from './scene/intro';
  import { startScene } from './scene/scene';

  /**
   * 経過日数による表示を、閲覧した日で判定し直す。
   * ページはビルドした日の状態で生成されるため、そのままだと日がたっても「7日以内」の表示が残る
   */
  function updateFreshness() {
    const today = new Date();
    const latest = document.querySelector<HTMLElement>('[data-latest]');
    if (latest) latest.dataset.freshness = freshnessOf(daysSince(latest.dataset.latest!, today));
    // 惑星のラベルの点は、7日以内に更新があったときだけ出す
    for (const dot of document.querySelectorAll<HTMLElement>('[data-fresh]')) {
      dot.hidden = daysSince(dot.dataset.fresh!, today) > 7;
    }
  }

  /** 停止ボタンで止めた状態の保存先。次に開いたときも止まったままにする */
  const MOTION_KEY = 'home-motion';

  /**
   * 最初に止めた状態にするか。
   * 停止ボタンで選んだ状態を優先し、選んでいなければ OS の「視差効果を減らす」設定に従う
   */
  function initiallyPaused(): boolean {
    let saved: string | null = null;
    try {
      saved = localStorage.getItem(MOTION_KEY);
    } catch {
      // 読めないときは OS の設定に従う
    }
    if (saved) return saved === 'paused';
    return matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function saveMotion(paused: boolean) {
    try {
      localStorage.setItem(MOTION_KEY, paused ? 'paused' : 'playing');
    } catch {
      // 保存できなくても、このページを見ている間は止まっている
    }
  }

  /** 動いているシーン・イントロを止める関数。Home 以外のページでは空 */
  let stops: (() => void)[] = [];

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-home]');
    if (!root) return;
    updateFreshness();
    // イントロを再生するかは、ルート直後のスクリプトが data-intro で決めている
    const intro = root.dataset.intro
      ? createIntro(root.dataset.introSpeed === 'quick', performance.now() / 1000)
      : undefined;
    const paused = initiallyPaused();
    const scene = startScene(root, { intro, paused });
    stops = [scene.stop, ...(intro ? [runIntro(root, intro)] : [])];

    // 停止ボタン。要素ごと遷移で破棄されるため、リスナーの解除は不要
    const toggle = root.querySelector<HTMLButtonElement>('[data-motion-toggle]')!;
    const apply = (next: boolean) => {
      scene.setPaused(next);
      root.toggleAttribute('data-paused', next);
      toggle.setAttribute('aria-label', next ? '背景の動きを再開する' : '背景の動きを止める');
    };
    apply(paused);
    toggle.addEventListener('click', () => {
      const next = !root.hasAttribute('data-paused');
      apply(next);
      saveMotion(next);
    });
  });

  // Home から離れるときに、描画・タイマー・イベントリスナーを止める（遷移のたびに重複させない）
  document.addEventListener('astro:before-swap', () => {
    for (const stop of stops) stop();
    stops = [];
  });
</script>

---
/**
 * About の本文（.users/requirements/screens.md §5.1）
 *
 * 名前・職種 → Strengths → Values → Next → 外部リンク → Latest Activity。
 * Latest Activity は、Activity がまだないうちは見出しごと表示しない
 */
import ActivityTimeline from '@/components/ui/ActivityTimeline.astro';
import Icon from '@/components/ui/Icon.astro';
import Subheading from '@/components/ui/Subheading.astro';
import TechTags from '@/components/ui/TechTags.astro';
import type { AboutPage } from './load-about';

interface Props {
  page: AboutPage;
}

const { page } = Astro.props;
---

<section class:list={['pb-12', page.latestActivity.length > 0 && 'border-b border-white/10']}>
  <p class="text-2xl font-light tracking-[0.12em] text-white sm:text-3xl">{page.name}</p>
  <p class="mt-2 text-xs tracking-[0.3em] text-white/50 uppercase">
    {page.headline.map((part, i) => (
      <>
        {i > 0 && <span class="mx-2 text-white/25">·</span>}
        {part}
      </>
    ))}
  </p>

  <div class="mt-8">
    <Subheading label="Strengths" />
    <TechTags list={page.strengths} class="mt-3" />
  </div>

  <div class="mt-8">
    <Subheading label="Values" />
    <ul class="mt-4 space-y-2">
      {page.values.map((value) => (
        <li class="flex gap-3 text-sm leading-relaxed text-white/70">
          <span class="mt-2.5 h-px w-3 shrink-0 bg-white/30" />
          {value}
        </li>
      ))}
    </ul>
  </div>

  <div class="mt-8">
    <Subheading label="Next" />
    <p class="mt-3 text-sm tracking-wide text-white/80">{page.next}</p>
  </div>

  <div class="mt-8 flex flex-wrap gap-5">
    {page.links.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener"
        class="flex items-center gap-2 text-xs tracking-[0.2em] text-white/60 uppercase transition-colors hover:text-white"
      >
        <Icon name={link.icon} class="text-base" />
        {link.label}
      </a>
    ))}
  </div>
</section>

{page.latestActivity.length > 0 && (
  <section class="pt-12">
    <h2 class="flex items-center gap-3 text-[11px] tracking-[0.3em] text-white/55 uppercase">
      <span class="size-1.5 animate-live rounded-full bg-emerald-400 motion-reduce:animate-none" />
      Latest Activity
    </h2>
    <div class="mt-8">
      <ActivityTimeline groups={page.latestActivity} />
    </div>
    <a
      href="/activity"
      class="mt-10 inline-flex items-center gap-2 text-xs tracking-[0.2em] text-white/60 uppercase transition-colors hover:text-white"
    >
      すべての Activity を見る
      <Icon name="arrow-right" />
    </a>
  </section>
)}

---
/**
 * 記事詳細（.users/requirements/screens.md §5.8）
 *
 * 日付・Category・Tech タグ → 要約 → 本文（MDX）→ Related Works → Related Tech。
 * Related Works は記事で明示的に関連付けたものだけを出す（Tech が共通なだけの作品は、Tech 詳細から辿れるため）
 */
import Prose from '@/components/ui/Prose.astro';
import Subheading from '@/components/ui/Subheading.astro';
import TechTags from '@/components/ui/TechTags.astro';
import type { NoteDetail } from './load-notes';

interface Props {
  note: NoteDetail;
}

const { note } = Astro.props;
const { Content } = note;
---

<div class="-mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-white/50">
  <time datetime={note.date}>{note.date}</time>
  {note.updated && (
    <span>
      更新 <time datetime={note.updated}>{note.updated}</time>
    </span>
  )}
  <span class="tracking-[0.2em] text-(--accent) uppercase">{note.category}</span>
</div>
<TechTags list={note.tags} class="mt-3" />

<article class="mt-10 border-t border-white/10 pt-10">
  <p class="text-base leading-loose text-white/80">{note.summary}</p>
  <Prose headings="article" class="mt-8 leading-loose">
    <Content />
  </Prose>
</article>

{note.relatedWorks.length > 0 && (
  <section class="mt-14">
    <Subheading label="Related Works" />
    <ul class="mt-4 divide-y divide-white/10 border-y border-white/10">
      {note.relatedWorks.map((work) => (
        <li class="py-4">
          <a href={work.href} class="text-base text-white transition-colors hover:text-(--accent)">
            {work.title}
          </a>
          <p class="mt-1 text-sm text-white/55">{work.summary}</p>
        </li>
      ))}
    </ul>
  </section>
)}

<section class="mt-14">
  <Subheading label="Related Tech" />
  <TechTags list={note.tags} class="mt-3" />
</section>

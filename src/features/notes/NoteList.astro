---
/**
 * 記事一覧（.users/requirements/screens.md §5.7）
 *
 * 記事の本文は Zenn で公開しているため、タイトルから Zenn の記事を新しいタブで開く。
 * 初期表示は10件。残りは「もっと見る」で展開する（JavaScript なしでは全件表示）。
 * 技術記事は Zenn に書くため、末尾に Zenn への案内を置く。記事が0件でも出す
 */
import ExternalLink from '@/components/ui/ExternalLink.astro';
import MoreLink from '@/components/ui/MoreLink.astro';
import ShowMore from '@/components/ui/ShowMore.astro';
import TechTags from '@/components/ui/TechTags.astro';
import type { NoteListItem } from './load-notes';

interface Props {
  notes: NoteListItem[];
  /** Zenn のプロフィールの URL。なければ案内を出さない */
  zenn?: string;
}

const LIMIT = 10;
const { notes, zenn } = Astro.props;
---

{notes.length === 0 ? (
  <p class="text-sm text-white/55">まだありません</p>
) : (
  <ShowMore rest={Math.max(0, notes.length - LIMIT)}>
    <ul class="divide-y divide-white/10 border-t border-white/10">
      {notes.map((note, i) => (
        <li
          class="grid gap-1 py-6 sm:grid-cols-[7rem_1fr] sm:gap-6"
          data-extra={i >= LIMIT ? '' : undefined}
        >
          <time datetime={note.date} class="pt-1 text-xs text-white/55">
            {note.date}
          </time>
          <div class="min-w-0">
            <ExternalLink
              href={note.href}
              class="block text-base text-white/90 hover:text-white sm:text-lg"
            >
              {note.title}
            </ExternalLink>
            <TechTags list={note.tags} class="mt-3" />
          </div>
        </li>
      ))}
    </ul>
  </ShowMore>
)}

{zenn && (
  <MoreLink href={zenn} external class="mt-10">
    Zenn の技術記事を見る
  </MoreLink>
)}

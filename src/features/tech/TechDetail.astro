---
/**
 * Tech 詳細（.users/requirements/screens.md §5.6）
 *
 * 種類別（Works / Notes / Career / Activity）の実績を件数付きで並べ、最後に関連 Tech を出す。
 * 0件の種類も見出しを残し「まだありません」と表示する（実績がないことも情報として示す）
 */
import Chip from '@/components/ui/Chip.astro';
import ExternalLink from '@/components/ui/ExternalLink.astro';
import Subheading from '@/components/ui/Subheading.astro';
import type { TechDetail } from './load-tech';

interface Props {
  tech: TechDetail;
}

const { tech } = Astro.props;
const listClass = 'mt-5 divide-y divide-white/10 border-y border-white/10';
const emptyClass = 'mt-5 text-sm text-white/50';
---

{tech.childNames.length > 0 && (
  <p class="-mt-4 mb-2 text-xs text-white/55">
    下位の技術（{tech.childNames.join(' · ')}）の実績も含みます。
  </p>
)}

<section class="mt-12">
  <Subheading label="Works" count={tech.works.length} />
  {tech.works.length > 0 ? (
    <ul class={listClass}>
      {tech.works.map((work) => (
        <li class="py-4">
          <a href={work.href} class="text-base text-white transition-colors hover:text-(--accent)">
            {work.title}
          </a>
          <p class="mt-1 text-sm text-white/55">{work.summary}</p>
        </li>
      ))}
    </ul>
  ) : (
    <p class={emptyClass}>まだありません</p>
  )}
</section>

<section class="mt-12">
  <Subheading label="Notes" count={tech.notes.length} />
  {tech.notes.length > 0 ? (
    <ul class={listClass}>
      {tech.notes.map((note) => (
        <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:gap-6">
          <time datetime={note.date} class="w-28 shrink-0 text-xs text-white/55">
            {note.date}
          </time>
          <ExternalLink href={note.href} class="text-base text-white/90 hover:text-white">
            {note.title}
          </ExternalLink>
        </li>
      ))}
    </ul>
  ) : (
    <p class={emptyClass}>まだありません</p>
  )}
</section>

<section class="mt-12">
  <Subheading label="Career" count={tech.career.length} />
  {tech.career.length > 0 ? (
    <ul class={listClass}>
      {tech.career.map((career) => (
        <li class="py-4">
          <p class="text-base text-white">
            {career.org}
            <span class="ml-2 text-sm text-white/50">{career.role}</span>
          </p>
          <p class="mt-1 text-xs text-white/55">{career.period}</p>
        </li>
      ))}
    </ul>
  ) : (
    <p class={emptyClass}>まだありません</p>
  )}
</section>

<section class="mt-12">
  <Subheading label="Activity" count={tech.activity.length} />
  {tech.activity.length > 0 ? (
    <ul class={listClass}>
      {tech.activity.map((activity) => (
        <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:gap-6">
          <time datetime={activity.date} class="w-28 shrink-0 text-xs text-white/55">
            {activity.date}
          </time>
          <p class="text-sm text-white/70">
            <span class="text-white">{activity.work}</span>
            <span class="mx-2 text-white/20">—</span>
            {activity.headline}
          </p>
        </li>
      ))}
    </ul>
  ) : (
    <p class={emptyClass}>まだありません</p>
  )}
</section>

{tech.related.length > 0 && (
  <section class="mt-12">
    <Subheading label="Related Tech" />
    <div class="mt-3 flex flex-wrap gap-2">
      {tech.related.map((related) => (
        <Chip href={related.href} label={related.label} />
      ))}
    </div>
  </section>
)}

---
/**
 * 404（存在しない URL）
 *
 * GitHub Pages は、存在しない URL に対してこのページ（404.html）を返す。
 * 本文は features/not-found/NotFound.astro が組み立てる
 */
import NotFound from '@/features/not-found/NotFound.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { pageTitle } from '@/lib/site';
---

<BaseLayout title={pageTitle('Not Found')}>
  <NotFound />
</BaseLayout>

---
/**
 * 404（存在しない URL）
 *
 * GitHub Pages は、存在しない URL に対してこのページ（404.html）を返す。
 * どのセクションにも属さないため SectionLayout を使わず、Home と各セクションへの入口だけを置く
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SECTION_IDS, SECTIONS } from '@/lib/sections';
import { pageTitle } from '@/lib/site';
---

<BaseLayout title={pageTitle('Not Found')}>
  <main class="mx-auto flex min-h-dvh max-w-3xl flex-col justify-center px-6 py-16 sm:px-10">
    <p class="text-[11px] tracking-[0.3em] text-white/40 uppercase">404</p>
    <h1 class="mt-3 text-2xl font-light tracking-[0.18em] text-white uppercase sm:text-4xl">
      Not Found
    </h1>
    <p class="mt-4 text-sm leading-relaxed text-white/60">
      お探しのページは見つかりませんでした。URL が変わったか、削除された可能性があります。
    </p>
    <nav aria-label="セクション" class="mt-10 flex flex-wrap gap-2">
      <a
        href="/"
        class="rounded-full border border-white/20 px-3 py-1.5 text-[11px] tracking-wide text-white/80 transition-colors hover:border-white/50 hover:text-white"
      >
        Home
      </a>
      {SECTION_IDS.map((id) => (
        <a
          href={SECTIONS[id].href}
          class="rounded-full border border-white/10 px-3 py-1.5 text-[11px] tracking-wide text-white/50 transition-colors hover:border-white/40 hover:text-white"
        >
          {SECTIONS[id].title}
        </a>
      ))}
    </nav>
  </main>
</BaseLayout>

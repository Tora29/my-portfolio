---
/**
 * 記事一覧（/notes）
 *
 * 書いた記事を新しい順に並べ、末尾で Zenn の記事へ案内する（.users/requirements/screens.md §5.7）。
 * 表示用のデータの組み立ては features/notes/load-notes.ts が行い、ページは受け渡しだけをする
 */
import { loadNotesPage } from '@/features/notes/load-notes';
import NoteList from '@/features/notes/NoteList.astro';
import SectionLayout from '@/layouts/SectionLayout.astro';

const { notes, zenn } = await loadNotesPage();
---

<SectionLayout section="notes">
  <NoteList notes={notes} zenn={zenn} />
</SectionLayout>

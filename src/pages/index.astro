---
/**
 * Home（/）
 *
 * 宇宙のシーン。中央の名前と4つの惑星から各セクションへ入る（.users/requirements/screens.md §4）。
 * 表示用のデータの組み立ては features/home/load-home.ts が行い、ページは受け渡しだけをする
 */
import { loadHomePage } from '@/features/home/load-home';
import HomeScene from '@/features/home/HomeScene.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_NAME } from '@/lib/site';
import { loadProfile } from '@/lib/load-profile';
import { homeStructuredData } from '@/lib/structured-data';

const [page, profile] = await Promise.all([loadHomePage(), loadProfile()]);
// 名前だけの <title> は同名の別サイトと区別できないため、職種を添える
const title = `${SITE_NAME} | ${profile.role}`;
---

<BaseLayout
  title={title}
  description={`${profile.role}。${profile.intro}`}
  structuredData={homeStructuredData(profile, Astro.site!)}
>
  <HomeScene page={page} />
</BaseLayout>
